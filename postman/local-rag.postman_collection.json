{
  "info": {
    "name": "Local electronics RAG smoke checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:8876"
    },
    {
      "key": "admin_password",
      "value": "change-this-for-local-test"
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{base}}/api/login",
        "header": [{"key":"Content-Type","value":"application/json"}],
        "body": {"mode":"raw","raw":"{\"username\":\"admin\",\"password\":\"{{admin_password}}\"}"}
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200));",
              "const body=pm.response.json(); pm.test('csrf present',()=>pm.expect(body.csrf).to.be.a('string')); pm.collectionVariables.set('csrf',body.csrf);"
            ]
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "request": {
        "method": "GET",
        "url": "{{base}}/api/catalog",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('41 mock records',()=>pm.expect(pm.response.json().records).to.equal(41));"
            ]
          }
        }
      ]
    },
    {
      "name": "Warranty source",
      "request": {
        "method": "POST",
        "url": "{{base}}/api/ask",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"product\": \"LAP-A14\", \"question\": \"Sản phẩm được bảo hành bao lâu?\", \"use_model\": true}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200));",
              "pm.test('expected status',()=>pm.expect(pm.response.json().status).to.equal('evidence'));",
              "pm.test('mock labelled',()=>pm.expect(pm.response.json().mock).to.equal(true));",
              "pm.test('correct evidence',()=>pm.expect(pm.response.json().citations.map(c=>c.text).join(' ')).to.include('24 tháng'));"
            ]
          }
        }
      ]
    },
